# Email provider selection: "gmail" or "freemail"
EMAIL_PROVIDER=freemail

# Gmail OAuth tokens (required if EMAIL_PROVIDER=gmail)
# File format: email -> {client_id, client_secret, refresh_token, access_token, token_expiry}
GMAIL_TOKENS_PATH=gmail-tokens.json

# Freemail REST API (required if EMAIL_PROVIDER=freemail)
FREEMAIL_API_URL=https://your-freemail-api.example.com
FREEMAIL_API_TOKEN=replace-with-your-freemail-token

# Proxy for CloakBrowser (required for geoIP)
# Format: protocol://user:pass@host:port
PROXY_URL=

# Registration defaults
DEFAULT_COUNT=1
DEFAULT_CONCURRENCY=2
DEFAULT_DELAY=10

# Email polling
EMAIL_CODE_TIMEOUT=90
EMAIL_POLL_INTERVAL=3

# API key verification
API_KEY_TIMEOUT=20

# MySearch proxy upload (auto-sync verified keys)
SERVER_URL=https://mysearch.porsed.com
SERVER_ADMIN_PASSWORD=your-admin-password
